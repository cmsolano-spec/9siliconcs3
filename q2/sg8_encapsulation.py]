class BankAccount:
    def __init__(self, account_number, balance):
        self.__account_number = account_number
        self.balance = balance
        
    @property
    def account_number(self):
        return self.__account_number #getter       
    @property
    def balance(self):
        return self.__balance #getter
        
    @account_number.setter
    def account_number(self, account_number): #setter
        self.__account_number = account_number 
    
    @balance.setter
    def balance (self, new_balance):  #setter
        if new_balance >= 0:
            self.__balance = new_balance
        else:
            self.__balance = None #This can be any number, letter, however, i didn't was to change the protected data into something else with a value

    def display_info(self):
        print(f"Account Number: {self.__account_number}")
        if self.__balance is not None :
            print(f"Balance: {self.__balance} \n")
        else:
            print("The balance must not be a negative number.")
            
print("Account 1")
a1 = BankAccount(12345,1000)
a1.display_info()

